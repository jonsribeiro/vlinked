# ============================================
# VLINKED - VARIÁVEIS DE AMBIENTE
# ============================================

# --------------------------------------------
# AMBIENTE
# --------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORRELATION_ID_HEADER=x-correlation-id

# --------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# --------------------------------------------
DATABASE_URL="postgresql://vlinked:vlinked_dev@localhost:5432/vlinked?schema=public"

# --------------------------------------------
# CACHE (Redis)
# --------------------------------------------
REDIS_URL="redis://localhost:6379"

# --------------------------------------------
# JWT (Autenticação)
# --------------------------------------------
JWT_SECRET="sua-chave-secreta-aqui-minimo-32-caracteres"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --------------------------------------------
# EMAIL (Escolher um)
# --------------------------------------------
# Resend
RESEND_API_KEY="re_xxxxxxxx"
# ou SendGrid
SENDGRID_API_KEY="SG.xxxxxxxx"

# --------------------------------------------
# CLOUDFLARE R2 (Storage de Vídeos)
# --------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="vlinked-videos-dev"
R2_PUBLIC_URL=""

# --------------------------------------------
# OPENAI (AI Director)
# --------------------------------------------
OPENAI_API_KEY="sk-xxxxxxxx"
OPENAI_WHISPER_MODEL="whisper-1"
OPENAI_GPT_MODEL="gpt-4-turbo-preview"

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_UPLOAD_MAX=1
RATE_LIMIT_AI_WINDOW=3600
RATE_LIMIT_AI_MAX=20

# --------------------------------------------
# MONITORAMENTO
# --------------------------------------------
SENTRY_DSN=""
