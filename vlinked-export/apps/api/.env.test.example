# Test Environment Variables
# Copy this file to .env.test and fill in your values

# Database (use a separate test database!)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vlinked_test

# JWT
JWT_SECRET=your-test-secret-key-min-32-characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_URL=redis://localhost:6379

# Email (mock for tests)
RESEND_API_KEY=mock
EMAIL_FROM=test@vlinked.app
FRONTEND_URL=http://localhost:3000

# Sentry (optional for tests)
SENTRY_DSN=mock

# Storage (mock for tests)
R2_ACCOUNT_ID=mock
STORAGE_ACCESS_KEY_ID=mock
STORAGE_SECRET_ACCESS_KEY=mock
STORAGE_BUCKET_NAME=vlinked-test
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://mock.r2.cloudflarestorage.com

# OpenAI (mock for tests)
OPENAI_API_KEY=mock

# Node Environment
NODE_ENV=test
LOG_LEVEL=error
