# ============================================
# VLINKED API - STAGING ENVIRONMENT
# ============================================

# AMBIENTE
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id

# BANCO DE DADOS
DATABASE_URL="postgresql://vlinked:vlinked_staging@postgres:5432/vlinked?schema=public"

# REDIS
REDIS_URL="redis://redis:6379"

# JWT (GERAR NOVA CHAVE PARA PRODUÇÃO!)
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# STORAGE (Cloudflare R2)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-r2-account-id
STORAGE_BUCKET=vlinked-staging-uploads
STORAGE_ACCESS_KEY_ID=your-r2-access-key
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-key
STORAGE_PUBLIC_URL=https://cdn-staging.vlinked.app

# OPENAI (para análise de IA)
OPENAI_API_KEY=your-openai-api-key
AI_MOCK_ENABLED=false

# VIRUS SCAN
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_FAIL_OPEN=true

# FRONTEND URL (para links de compartilhamento)
FRONTEND_URL=https://staging.vlinked.app
